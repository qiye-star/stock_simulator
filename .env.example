# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 不入库。DATABASE_URL 中的密码若含 @ : / ? # 等字符需做 URL 编码。

# ---------- 前端入口 ----------
# 宿主机访问端口（容器内 nginx 监听 8080）
FRONTEND_PORT=18000

# ---------- 数据库 ----------
# 三选一。默认 sqlite（数据存放在 compose 卷 backend-data 的 /data/stocksim.db）
#
# 1) sqlite（默认，无需额外服务）
DATABASE_URL=sqlite:////data/stocksim.db
#
# 2) postgres：需要 `--profile postgres`，主机名为 compose 服务名 postgres
# DATABASE_URL=postgresql+psycopg://stocksim:change-me@postgres:5432/stocksim
#
# 3) mysql：需要 `--profile mysql`，必须带 charset=utf8mb4
# DATABASE_URL=mysql+pymysql://stocksim:change-me@mysql:3306/stocksim?charset=utf8mb4

# 仅在使用 --profile postgres 时生效（与上面 DATABASE_URL 中的密码保持一致）
POSTGRES_USER=stocksim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocksim

# 仅在使用 --profile mysql 时生效
MYSQL_DATABASE=stocksim
MYSQL_USER=stocksim
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- 后端行为 ----------
# 调试接口（/saves/{id}/debug/*），生产环境保持 false
ENABLE_DEBUG_API=false
# 每个交易日包含的行情 tick 数（契约默认 20）
TICKS_PER_TRADING_DAY=20

# ---------- 开发覆盖层（docker-compose.dev.yml）----------
BACKEND_DEV_PORT=18001
FRONTEND_DEV_PORT=5173
