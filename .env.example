# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 不入库。DATABASE_URL 中的密码若含 @ : / ? # 等字符需做 URL 编码。

# ---------- 构建镜像源（国内默认值，海外服务器可改回官方源）----------
# 后端 pip/uv 依赖：官方源为 https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 前端 npm 依赖：官方源为 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 前端入口 ----------
# 宿主机访问端口（容器内 nginx 监听 8080）
FRONTEND_PORT=18000

# ---------- 手机版入口 ----------
# 手机版（mobile 服务）宿主机端口，容器内 nginx 监听 8080；与网页版共用同一个后端与数据库
# 开发覆盖层的后端调试端口 BACKEND_DEV_PORT 默认 18002，避免与此处冲突
MOBILE_PORT=18001

# ---------- 数据库 ----------
# 三选一。默认 sqlite（数据存放在 compose 卷 backend-data 的 /data/stocksim.db）
#
# 1) sqlite（默认，无需额外服务）
DATABASE_URL=sqlite:////data/stocksim.db
#
# 2) postgres：需要 `--profile postgres`，主机名为 compose 服务名 postgres
# DATABASE_URL=postgresql+psycopg://stocksim:change-me@postgres:5432/stocksim
#
# 3) mysql：需要 `--profile mysql`，必须带 charset=utf8mb4
# DATABASE_URL=mysql+pymysql://stocksim:change-me@mysql:3306/stocksim?charset=utf8mb4

# 仅在使用 --profile postgres 时生效（与上面 DATABASE_URL 中的密码保持一致）
POSTGRES_USER=stocksim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocksim

# 仅在使用 --profile mysql 时生效
MYSQL_DATABASE=stocksim
MYSQL_USER=stocksim
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- 后端行为 ----------
# 会话签名密钥（>=16 字符随机串；生产必须修改，否则后端启动会告警）
SECRET_KEY=dev-insecure-change-me-please
# Cookie 的 Secure 标记：经外层 HTTPS（a.com / m.a.com）访问时必须为 true，
# 否则 Cookie 可能经明文链路发送；纯 http://localhost 验证时保持 false
# （设为 true 后，用 http://IP:端口 等非 HTTPS 地址访问将无法保持登录；localhost 例外）
COOKIE_SECURE=false
# 调试接口（/saves/{id}/debug/*），生产环境保持 false
ENABLE_DEBUG_API=false
# 每个交易日包含的行情 tick 数（契约默认 20）
TICKS_PER_TRADING_DAY=20

# ---------- 每日挑战（03 §11.1；challenge-runner 服务与 backend 共用这些变量）----------
# CHALLENGE_SEED_KEY 生产必须设置（为空则由 SECRET_KEY 派生，开发密钥下 seed 可预测）
# CHALLENGE_SCHEDULE=compact 仅开发/e2e，要求 ENABLE_DEBUG_API=true；生产保持 daily
CHALLENGE_ENABLED=true
CHALLENGE_SEED_KEY=
CHALLENGE_SCHEDULE=daily
CHALLENGE_SLOTS=07:00,12:00,17:00,20:30,23:00
CHALLENGE_TICK_MS=750
CHALLENGE_HOLD_POLL_MS=5000
CHALLENGE_COMPACT_SLOT_SECONDS=30
CHALLENGE_COMPACT_TICK_MS=10
CHALLENGE_MIN_ACCOUNT_AGE_HOURS=72
CHALLENGE_PLAYER_RETENTION_DAYS=14
CHALLENGE_MARKET_RETENTION_DAYS=30
CHALLENGE_RUN_DUE_MIN_INTERVAL_S=10

# ---------- 预测市场（模式 D，docs/10.26-plan/04-预测市场.md §8.1；多实例说明见 docs/deployment.md §6a'）----------
# 每个 backend 实例上的 Hub 轮询与 sweeper；只有 API 的副本可设 false
PM_BACKGROUND_ENABLED=true
PM_POLL_MS=1000
PM_SWEEP_MS=10000

# ---------- 真实复盘定时抓存（replay-collector，profile: collector，默认不启动；见 docs/deployment.md §6b）----------
# pool = 股票池中的真实 A 股代码（约 384 只，排除彩蛋 999999）；也可写逗号分隔的 6 位代码
REPLAY_COLLECT_UNIVERSE=pool
# 东财与财联社经 requests 访问，需要代理时取消注释；留空即直连
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---------- 开发覆盖层（docker-compose.dev.yml）----------
BACKEND_DEV_PORT=18002
FRONTEND_DEV_PORT=5173
