# 由 nginx-unprivileged 入口脚本在启动时渲染（仅替换 NGINX_ENVSUBST_FILTER 匹配的变量，即 BACKEND_*）。
# nginx 自身变量（$uri、$host 等）保持原样。

# WebSocket 升级：有 Upgrade 头则 upgrade，否则 close
# 外层反代（宿主机 nginx）终止 TLS 后会带 X-Forwarded-Proto: https；有则透传，没有（直连容器）才用本层 $scheme
map $http_x_forwarded_proto $stocksim_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 按路径决定 Cache-Control：带哈希的静态资源长缓存，其余（含 index.html）不缓存
map $uri $stocksim_cache_control {
    default        "no-cache";
    ~^/assets/     "public, max-age=31536000, immutable";
    ~^/api/        "no-store";
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    # ---- gzip ----
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml;

    # ---- 安全响应头（add_header 在 server 级别设置，location 未定义 add_header 时自动继承）----
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Cache-Control $stocksim_cache_control always;

    # 健康检查（不经过后端）
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # WebSocket：行情推送，连接可长期保持，读超时 1 小时
    location /api/v1/ws/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $stocksim_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # REST API
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $stocksim_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 构建产物：文件名带内容哈希，允许长期缓存；缺失时直接 404，不回退到 index.html
    location /assets/ {
        try_files $uri =404;
    }

    # SPA 回退：未知路径返回 index.html（不缓存）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
