# 生产用 nginx 模板：静态托管 mobile-prototype，并把同源 /api 反代到后端（含 WebSocket）。
# 安全基线与 frontend/nginx/default.conf.template 对齐：安全响应头 + CSP、gzip、/healthz、client_max_body_size。
# 渲染方式：mobile-prototype/Dockerfile 把本文件放到 /etc/nginx/templates/default.conf.template，
# 由 nginx-unprivileged 入口脚本在启动时只替换 BACKEND_*（NGINX_ENVSUBST_FILTER），nginx 变量保持原样。
# BACKEND_UPSTREAM 须带 http:// 前缀（如 http://backend:8000）。
# 注意：Cookie 会话 `session` 的 Secure 标记由后端 COOKIE_SECURE 决定；外层 HTTPS 部署时须设为 true。
#
# CSP 说明（按 index.html 与 js/ 实际用法核对过）：
#   - script-src 'self'：全部为外链经典脚本，无内联脚本、无 eval；
#   - style-src 'unsafe-inline'：页面模板里大量 style="..." 内联样式属性（骨架屏、进度条宽度等）；
#   - img-src data:：index.html 的 favicon 是 data:image/svg+xml；
#   - connect-src 'self'：fetch 与同源 WebSocket（现代浏览器中 'self' 覆盖同源 ws/wss；不放宽到任意主机）。

# 按路径决定 Cache-Control：静态文件无哈希文件名，每次校验；/api 不缓存
# （用 map + 单条 server 级 add_header，避免 location 内重复 add_header 导致安全头丢失）
map $uri $stocksim_cache_control {
    default        "no-cache";
    ~^/api/        "no-store";
}

# 外层反代（宿主机 nginx）终止 TLS 后会带 X-Forwarded-Proto: https；有则透传，没有（直连容器）才用本层 $scheme
map $http_x_forwarded_proto $stocksim_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    # ---- gzip ----
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml;

    # ---- 安全响应头（server 级；location 内若再写 add_header 会覆盖继承，故各 location 需重复）----
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Cache-Control $stocksim_cache_control always;

    # 健康检查（不经过后端）
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 行情 WebSocket：长连接，读超时 1 小时（必须在 /api/ 之前声明更具体的前缀）
    location /api/v1/ws/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $stocksim_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # REST API
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $stocksim_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
    }

    # 静态文件：无构建、无哈希文件名，所以不做长缓存（每次校验）
    location / {
        try_files $uri $uri/ =404;
    }
}
