# 复制为 backend/.env 后按需修改。.env 已在根 .gitignore 中忽略。

# 数据库：sqlite（默认）/ postgresql+psycopg://user:pass@host/db / mysql+pymysql://user:pass@host/db?charset=utf8mb4
DATABASE_URL=sqlite:///./data/stocksim.db

# 会话 token 的 HMAC 密钥，至少 16 位。生产环境必须替换为随机长串（如 `openssl rand -hex 32`）
SECRET_KEY=dev-insecure-change-me-please

# 会话有效期（小时）与 Cookie 的 Secure 标记（HTTPS 部署时设为 true）
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# 调试接口（/saves/{id}/debug/*），仅本地开发打开
ENABLE_DEBUG_API=false

# 行情：离线补推上限（tick）与每交易日 tick 数
TICK_CATCHUP_MAX=300
TICKS_PER_TRADING_DAY=20

# 每日挑战（03 §11.1）。CHALLENGE_SEED_KEY 生产必须设置（否则由 SECRET_KEY 派生，开发密钥下 seed 可预测）
# CHALLENGE_ENABLED=true
# CHALLENGE_SEED_KEY=
# CHALLENGE_SCHEDULE=daily            # compact 仅开发/e2e，要求 ENABLE_DEBUG_API=true
# CHALLENGE_SLOTS=07:00,12:00,17:00,20:30,23:00
# CHALLENGE_TICK_MS=750
# CHALLENGE_HOLD_POLL_MS=5000
# CHALLENGE_COMPACT_SLOT_SECONDS=30
# CHALLENGE_COMPACT_TICK_MS=10
# CHALLENGE_MIN_ACCOUNT_AGE_HOURS=72
# CHALLENGE_PLAYER_RETENTION_DAYS=14
# CHALLENGE_MARKET_RETENTION_DAYS=30
# CHALLENGE_RUN_DUE_MIN_INTERVAL_S=10
# 预测市场后台 Hub 与 sweeper（04 §8.1）
# PM_BACKGROUND_ENABLED=true
# PM_POLL_MS=1000
# PM_SWEEP_MS=10000
